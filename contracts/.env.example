# Copy to .env (git-ignored) and fill in. Never put a private key in this file:
# import your deployer once with `cast wallet import raidpass --interactive` and pass --account raidpass.

# BNB Chain Testnet (chain id 97). Public endpoint works for scripts; fork tests are steadier on a private one.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# BNB Chain (chain id 56). Only needed for the mainnet fork tests.
BSC_RPC_URL=

{
  "schemaVersion": 2,
  "kind": "launcher-ui",
  "artifactId": "callz-launcher",
  "name": "CallZ NFT Mint Launcher",
  "chainId": 97,
  "factoryAddress": "0x1c43a0bbf01034c30c9d30f23c00e7f3019e678c",
  "configContract": "launcher-config-preview/v1",
  "surfaces": [
    "launcher-config",
    "launcher-ui"
  ],
  "entry": "Component.tsx",
  "reads": {
    "raised": {
      "functionName": "raised",
      "returns": "uint256"
    },
    "targetRaise": {
      "functionName": "targetRaise",
      "returns": "uint256"
    },
    "mintPrice": {
      "functionName": "nftPrice",
      "returns": "uint256"
    },
    "maxPasses": {
      "functionName": "maxNFTs",
      "returns": "uint256"
    },
    "minted": {
      "functionName": "minted",
      "returns": "uint256"
    },
    "saleDeadline": {
      "functionName": "saleDeadline",
      "returns": "uint256"
    },
    "tokensPerPass": {
      "functionName": "tokensPerNFT",
      "returns": "uint256"
    },
    "launched": {
      "functionName": "launched",
      "returns": "bool"
    },
    "refundAvailable": {
      "functionName": "refundAvailable",
      "returns": "bool"
    },
    "token": {
      "functionName": "token",
      "returns": "address"
    },
    "creator": {
      "functionName": "creator",
      "returns": "address"
    },
    "passes": {
      "functionName": "balanceOf",
      "returns": "uint256",
      "account": true
    },
    "claimable": {
      "functionName": "claimableOf",
      "returns": "uint256",
      "account": true
    },
    "refundable": {
      "functionName": "refundableOf",
      "returns": "uint256",
      "account": true
    }
  },
  "transactions": {
    "create": true,
    "actions": {
      "mint": "payable",
      "claim": "nonpayable",
      "refund": "nonpayable"
    }
  }
}

{
  "schemaVersion": 2,
  "kind": "launcher-ui",
  "artifactId": "raidpass-launcher",
  "name": "RaidPass NFT Mint Launcher",
  "chainId": 97,
  "factoryAddress": "0x4f51d78a3be8093ae11cb026d563c70c1b1e9e69",
  "configContract": "launcher-config-preview/v1",
  "surfaces": ["launcher-config", "launcher-ui"],
  "entry": "Component.tsx",
  "reads": {
    "raised": { "functionName": "raised", "returns": "uint256" },
    "targetRaise": { "functionName": "targetRaise", "returns": "uint256" },
    "mintPrice": { "functionName": "mintPrice", "returns": "uint256" },
    "maxPasses": { "functionName": "maxPasses", "returns": "uint256" },
    "minted": { "functionName": "minted", "returns": "uint256" },
    "saleDeadline": { "functionName": "saleDeadline", "returns": "uint256" },
    "tokensPerPass": { "functionName": "tokensPerPass", "returns": "uint256" },
    "launched": { "functionName": "launched", "returns": "bool" },
    "refundAvailable": { "functionName": "refundAvailable", "returns": "bool" },
    "token": { "functionName": "token", "returns": "address" },
    "creator": { "functionName": "creator", "returns": "address" },
    "passes": { "functionName": "balanceOf", "returns": "uint256", "account": true },
    "claimable": { "functionName": "claimableOf", "returns": "uint256", "account": true },
    "refundable": { "functionName": "refundableOf", "returns": "uint256", "account": true }
  },
  "transactions": {
    "create": true,
    "actions": {
      "mint": "payable",
      "claim": "nonpayable",
      "refund": "nonpayable"
    }
  }
}

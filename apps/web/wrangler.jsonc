{
  // The CallZ site and its indexer, as one Worker.
  //   - Static files for the pages. Visitors sign with their own wallets. The Worker holds no key that can move
  //     funds or approve anything. Its one optional secret, RELAYER_PRIVATE_KEY (set in the Cloudflare dashboard,
  //     never in this file), only pays the gas of relaying approved callouts to the vault.
  //   - /api/*: read-only JSON over the Pool Launch index.
  //   - A cron tick that reads new Pool Launch Portal events from public RPC endpoints into D1.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "raidpass",
  "main": "../worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // callz.fun and www.callz.fun are served by this Worker: Cloudflare creates their DNS records and
  // certificates. The workers.dev address stays on as well.
  "workers_dev": true,
  "routes": [
    { "pattern": "callz.fun", "custom_domain": true },
    { "pattern": "www.callz.fun", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raidpass-index",
      "database_id": "f9c442d0-44ec-45d0-8fe2-2b9310da3398",
      "migrations_dir": "../worker/migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // RPC requests one cron run may make across both chains. This account is on the Workers Paid plan.
    "SUBREQUEST_BUDGET": "400",
    // The wallet whose signature approves a callout. This is a public address, not a secret: the Worker
    // only checks signatures against it, and still holds no keys.
    "CALLOUT_ATTESTER": "0x2fcb91295c790d15d5f21ed9d95c6a89e0683c58",
    // The CallZ rewards vault that approvals are signed for. Written by scripts/callz-deployment.mjs: a public
    // contract address.
    "CALLZ_VAULT": "0x15Bb217b839614EC6a862cea438327FA035E230A"
  }
}

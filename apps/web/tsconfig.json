{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@launcher-ui/*": [
        "../../flap-ui/raidpass-launcher/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "../../flap-ui/raidpass-launcher/Component.tsx"
  ]
}
